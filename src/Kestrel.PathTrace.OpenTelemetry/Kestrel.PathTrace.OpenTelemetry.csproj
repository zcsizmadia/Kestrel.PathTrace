<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Kestrel.PathTrace.OpenTelemetry</AssemblyName>
    <RootNamespace>Kestrel.PathTrace.OpenTelemetry</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>OpenTelemetry exporter for Kestrel.PathTrace pipeline spans and tags.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kestrel.PathTrace\Kestrel.PathTrace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>


</Project>
