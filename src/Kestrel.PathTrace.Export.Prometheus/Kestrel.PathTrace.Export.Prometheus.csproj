<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Kestrel.PathTrace.Export.Prometheus</AssemblyName>
    <RootNamespace>Kestrel.PathTrace.Export.Prometheus</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Prometheus (prometheus-net) exporter for Kestrel.PathTrace latency histograms.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="prometheus-net.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kestrel.PathTrace\Kestrel.PathTrace.csproj" />
  </ItemGroup>

</Project>
