<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Kestrel.PathTrace</AssemblyName>
    <RootNamespace>Kestrel.PathTrace</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Per-request Kestrel pipeline latency tracing: NIC hardware timestamping through transport, middleware, endpoint, and writeback stages.</Description>
  </PropertyGroup>


  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <!-- Pack into runtimes/ in the .nupkg AND copy to the output dir for local runs.
         Using a single None item avoids the Content item's default content/ and
         contentFiles/ pack paths that would otherwise duplicate the binaries. -->
    <None Include="../../runtimes/**"
          Pack="true"
          PackagePath="runtimes/"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="runtimes\" />
  </ItemGroup>

</Project>
