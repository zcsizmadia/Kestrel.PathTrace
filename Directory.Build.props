<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors />
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <Authors>Zoltan Csizmadia</Authors>
    <Product>Kestrel.PathTrace</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/zcsizmadia/Kestrel.PathTrace</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zcsizmadia/Kestrel.PathTrace</PackageProjectUrl>
    <PackageTags>kestrel;aspnetcore;tracing;latency;opentelemetry;prometheus</PackageTags>

    <!-- Repo root — used by csproj files to reference runtimes/<RID>/native/ -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web SDK projects (samples) already include this implicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
  </ItemGroup>
</Project>
