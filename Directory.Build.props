<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>

    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <DefaultTargetFrameworks>net8.0;net9.0;net10.0</DefaultTargetFrameworks>

    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors />
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <Authors>Zoltan Csizmadia</Authors>
    <Product>Kestrel.PathTrace</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/zcsizmadia/Kestrel.PathTrace</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zcsizmadia/Kestrel.PathTrace</PackageProjectUrl>
    <PackageTags>kestrel;aspnetcore;tracing;latency;opentelemetry;prometheus</PackageTags>
    <PackageReleaseNotes><a href="https://github.com/zcsizmadia/Kestrel.PathTrace/releases">Release Notes</a></PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web SDK projects (samples) already include this implicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
  </ItemGroup>
</Project>
